# DataPulse Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Application ────────────────────────────────────────────────────
APP_NAME=DataPulse
APP_ENV=development          # development | production | testing
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ─── Security ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ───────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://datapulse:datapulse@localhost:5432/datapulse

# ─── File Storage ───────────────────────────────────────────────────
# Directory for uploaded dataset files (relative to project root or absolute)
UPLOAD_DIR=data/uploads

# Maximum upload file size in bytes (default: 52428800 = 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# Maximum number of rows to process per dataset
MAX_ROWS=1000000

# Maximum number of columns allowed per dataset
MAX_COLUMNS=500

# ─── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for development only)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── Pagination ─────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# ─── Rate Limiting ──────────────────────────────────────────────────
# Requests per minute for authentication endpoints
AUTH_RATE_LIMIT=20
